<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!--
      Backups are off deliberately. Booth is local-first and PRIVACY.md promises the library
      never leaves the device, so cloud backup, adb backup and device-to-device transfer are
      all excluded. allowBackup covers API 30 and below; dataExtractionRules is the Android 12+
      mechanism and is what lint expects at targetSdk 37. The user-driven export/import in
      Settings (PodcastBackupManager) is the only backup path. Do not re-enable either without
      updating PRIVACY.md.
    -->
    <application
        android:name=".BoothApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="33"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Booth">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Booth.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Exported on purpose and not negotiable: a MediaSessionService has to be discoverable by
            Android Auto, the assistant, Bluetooth and Wear, and the platform discovers it by binding
            to the service from outside the app. Setting exported="false" would leave the app with
            no lock screen, notification shade, headset or car transport at all, which is the centre
            of this product.

            The consequence is that any app on the device can bind and therefore browse the
            subscription and episode list and drive playback, which is the standard Android media
            session contract that every media app accepts. It is worth knowing about when deciding
            what to put in a podcast title. The three custom commands handed out in
            SessionCallback.onConnect, the sleep timer and skip-silence, are Booth's own controls
            exposed to those same external surfaces on purpose.

            ExportedService is suppressed rather than fixed for that reason.
        -->
        <service
            android:name=".PodcastPlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".data.PodcastDownloadReceiver"
            android:exported="true"
            android:permission="android.permission.SEND_DOWNLOAD_COMPLETED_INTENTS">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

        <!--
            Without this there is no path from a headset's buttons to the playback service at all.
            The system sends hardware media buttons as ACTION_MEDIA_BUTTON broadcasts, and Media3
            receives them through this receiver, which forwards them to PodcastPlaybackService.
            The service's own intent filters match the session and browser actions, not the button
            press. Issue #38: fast-forward and rewind did nothing on a Bluetooth headset because the
            broadcast had nowhere to go.
        -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
