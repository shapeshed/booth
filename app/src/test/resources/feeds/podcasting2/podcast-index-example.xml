<?xml version="1.0" encoding="UTF-8"?>
<!-- Shape based on the official Podcast Index namespace schema example. -->
<rss version="2.0"
    xmlns:podcast="https://podcastindex.org/namespace/1.0"
    xmlns:itunes="http://www.itunes.com/dtds/podcast-1.0.dtd">
  <channel>
    <title>Podcasting 2.0 Namespace Example</title>
    <description>Example feed carrying modern podcast metadata.</description>
    <podcast:locked owner="podcastowner@example.com">yes</podcast:locked>
    <podcast:funding url="https://example.com/donate">Support the show!</podcast:funding>
    <podcast:location geo="geo:30.2672,97.7431" osm="R113314">Austin, TX</podcast:location>
    <item>
      <guid>podcast-index-episode-1</guid>
      <title>Modern podcast metadata</title>
      <podcast:transcript url="https://example.com/episode-1.vtt" type="text/vtt" language="en"/>
      <podcast:chapters url="https://example.com/episode-1.json" type="application/json+chapters"/>
      <podcast:alternateEnclosure type="audio/mp4" length="42" bitrate="128" default="yes">
        <podcast:source uri="https://example.com/episode-1.m4a" contentType="audio/mp4"/>
      </podcast:alternateEnclosure>
      <podcast:value type="lightning" method="keysend" suggested="0.00000005000">
        <podcast:valueRecipient name="Example" type="node" address="03example" split="100"/>
      </podcast:value>
      <enclosure url="https://example.com/episode-1.mp3" length="42" type="audio/mpeg"/>
    </item>
  </channel>
</rss>
