# Editor and formatting conventions for Booth.
# https://editorconfig.org
#
# This is the shared baseline for IDEs and the ktlint configuration read by
# `./gradlew :app:ktlintCheck`. See docs/testing.md for the quality gate.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# ktlint reads these. Compose/Screenshot preview functions intentionally use
# PascalCase, so do not flag functions annotated with these as naming violations.
ktlint_code_style = android_studio
ktlint_function_naming_ignore_when_annotated_with = Composable, Preview, PreviewTest

# LocalPodcastMiniPlayerInset is a mutable compositionLocalOf with a default, because the inset
# changes as the mini player animates and every screen drawing above it should not have to supply
# one it does not care about. The rule's own escape hatch is this allowlist rather than a
# suppression, so the decision is declarative and survives the file being split. The rule matches on
# the declared name, not the qualified one.
compose_allowed_composition_locals = LocalPodcastMiniPlayerInset

[*.{gradle,toml}]
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.xml]
indent_size = 4

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2
